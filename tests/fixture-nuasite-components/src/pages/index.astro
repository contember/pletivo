---
import Form from "@nuasite/components/Form.astro";
---
<html>
  <head><title>Contact</title></head>
  <body>
    <h1>Contact</h1>
    <Form formId="contact">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required />
      <button type="submit">Send</button>
    </Form>
  </body>
</html>
