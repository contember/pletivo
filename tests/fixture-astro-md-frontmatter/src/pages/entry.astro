---
import { getEntry, render } from "astro:content";

const entry = await getEntry("docs", "entry");
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
---
<p id="entry">{remarkPluginFrontmatter.injected}</p><p id="data">{String(entry.data.injected)}</p><p id="headings">{JSON.stringify(headings)}</p><Content />
