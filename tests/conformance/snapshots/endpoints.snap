# pletivo conformance snapshot
# case:    endpoints
# project: tests/fixture-endpoint-routes
# covers:
#   - endpoint routes in src/pages: .json.ts, .xml.ts, .txt.ts
#   - endpoint output emitted at its own path, not wrapped in HTML
#   - extensionless .ts endpoint (GET, no default export) emitted as a file named after the route
#   - a .ts page with a default export next to GET() stays an HTML page
#   - a dynamic extensionless endpoint emits nothing
#
# Recorded from the "bun-build" adapter, but this file is not tied to it:
# any runtime claiming pletivo rendering parity must reproduce it exactly.
# Values in [brackets] are normalized — see tests/conformance/normalize.ts.
#
# Regenerate:  UPDATE_SNAPSHOTS=1 bun test tests/conformance
# Just this case:  UPDATE_SNAPSHOTS=1 CONFORMANCE_CASE=endpoints bun test tests/conformance

