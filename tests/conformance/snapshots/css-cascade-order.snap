--- pletivo:conformance tsx-entry/index.html ---
<!DOCTYPE html>
<html lang="en"><head><title>tsx entry</title><style>.cascade{--winner: first}
.cascade{--winner: second}</style>
</head><body><div class="second astro-[scope:2]">second</div><div class="first astro-[scope:1]">first</div></body></html>
