<html lang="cs"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Not Found</title><link rel="stylesheet" href="/style.[hash:1].css"></head><body><nav><a href="/">Home</a> | <a href="/about">About</a> | <a href="/blog">Blog</a></nav><main><h1>404</h1><p>Page not found. <a href="/">Go home</a>.</p></main></body></html>
