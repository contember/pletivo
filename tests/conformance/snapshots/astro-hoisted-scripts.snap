<!DOCTYPE html>
<html>
  <head><title>Scripts Test</title><script>const injectedHeadValue = "head-ok";
document.documentElement.dataset.injectedHead = injectedHeadValue;
</script>
<script type="module">document.documentElement.dataset.injectedPage=String(42);</script>
</head>
  <body>
    <h1>Scripts Test</h1>
    <button id="hoisted-btn">Click</button>
  <script type="module">class t extends HTMLElement{fieldInteractions=new Set;items=[];connectedCallback(){let e=document.getElementById("hoisted-btn");if(!e)return;e.addEventListener("click",(n)=>{this.fieldInteractions.add(String(n.timeStamp)),this.items.push({src:"x",alt:"y"})})}}customElements.define("hoisted-widget",t);</script></body></html>
