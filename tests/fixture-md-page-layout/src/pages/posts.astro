---
import { getCollection, render } from "astro:content";
import Note from "../components/Note.mdx";

const [post] = await getCollection("posts");
const { Content } = await render(post);
---
<html>
  <head><title>{post.data.title}</title></head>
  <body>
    <article data-layout={post.data.layout}><Content /></article>
    <aside><Note /></aside>
  </body>
</html>
