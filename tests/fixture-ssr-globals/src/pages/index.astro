---
// Shape of a real SSR-ish page ported onto pletivo: opts out of prerendering,
// sets edge-cache headers, and writes a cookie. Under pletivo the page is
// still prerendered; the headers/cookies are honoured in dev and dropped by
// the static build.
export const prerender = false;

Astro.response.headers.set("cache-control", "s-maxage=60");
Astro.cookies.set("visited", "1", { path: "/" });
const seen = Astro.cookies.get("seen")?.value ?? "none";
const ip = Astro.clientAddress ?? "none";
---

<!doctype html>
<html lang="en">
  <head>
    <title>Home</title>
  </head>
  <body>
    <h1>Home Page</h1>
    <p id="seen">{seen}</p>
    <p id="ip">{ip}</p>
  </body>
</html>
