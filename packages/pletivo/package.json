{
  "name": "pletivo",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contember/pletivo.git",
    "directory": "packages/pletivo"
  },
  "homepage": "https://github.com/contember/pletivo",
  "bugs": "https://github.com/contember/pletivo/issues",
  "publishConfig": {
    "access": "public"
  },
  "//scripts": "This directory is never the thing published — its dependencies name workspace packages that do not exist on the registry. Release stages a tarball with `bun run package:pletivo`; see scripts/package-pletivo.ts.",
  "scripts": {
    "prepublishOnly": "echo 'publish the staged tarball from scripts/package-pletivo.ts, not this directory' >&2 && exit 1"
  },
  "bin": {
    "pletivo": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/runtime/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/runtime/jsx-runtime.ts",
    "./hooks": "./src/runtime/hooks.ts",
    "./content": "./src/content/index.ts",
    "./astro-shim": "./src/runtime/astro-shim.ts"
  },
  "dependencies": {
    "@astrojs/compiler": "^2 || ^3",
    "@mdx-js/mdx": "^3.1.0",
    "@pletivo/core": "workspace:*",
    "@pletivo/runtime": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1",
    "morphdom": "^2.7.8",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "preact": "^10.29.1",
    "typescript": ">=5.7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "//": "README.md is copied in from the repo root when the release tarball is staged; it is not a file in this directory.",
  "files": [
    "src",
    "README.md"
  ],
  "devDependencies": {
    "preact": "^10.29.1"
  }
}
