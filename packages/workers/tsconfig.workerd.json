{
  // The qualification worker. `bun` stays in `types` only for node's types,
  // which `nodejs_compat` provides at run time; no DOM lib, workerd has its own.
  "extends": "../../tsconfig.json",
  "include": ["test/workerd/entry.ts", "test/workerd/globals.d.ts", "src/astro-wasm.d.ts"],
  "exclude": [],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun", "@cloudflare/workers-types"],
    "lib": ["ESNext"]
  }
}
