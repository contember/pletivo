---
// Outside the site root, with a scoped <style>: its scope id is hashed from the
// normalizedFilename, which both hosts must spell the same way for this file.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article class="card">
  <h2>{title}</h2>
  <slot />
</article>

<style>
  .card {
    border: 1px solid currentColor;
    padding: 1rem;
  }
</style>
