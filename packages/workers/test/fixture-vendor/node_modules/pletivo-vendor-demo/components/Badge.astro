---
// The astro-icon shape, in miniature: a component that lives in node_modules, reads a
// frozen virtual module for its data, and carries a scoped <style> whose hash comes
// from *this file's* name — so both hosts have to spell that name the same way.
import tokens from "virtual:vendor-demo";
import { FALLBACK } from "./palette.js";

interface Props {
  tone: string;
  label: string;
}

const { tone, label } = Astro.props;
const color = tokens.tones[tone] ?? FALLBACK;
---

<span class="badge" style={`--badge-color: ${color}`}>{label}</span>

<style>
  .badge {
    color: var(--badge-color);
    font-weight: 600;
  }
</style>
