{
  "name": "@pletivo/core",
  "description": "Host-agnostic Pletivo engine: router, i18n, markdown, content collections, image service. Ships TypeScript source.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contember/pletivo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/contember/pletivo",
  "bugs": "https://github.com/contember/pletivo/issues",
  "publishConfig": {
    "access": "public"
  },
  "//": "No build step, by design — see the note in @pletivo/runtime.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "prepublishOnly": "echo 'publish the staged tarball from scripts/package-pletivo.ts, not this directory' >&2 && exit 1"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.0",
    "@pletivo/runtime": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  }
}
